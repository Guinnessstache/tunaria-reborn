# Options for the tunaria-reborn service. Copy to /etc/tunaria-reborn.env and edit.
# Any `python -m eqoa_server --help` option can go in TUNARIA_ARGS.
#
# --public-host   the IP address players connect to (this server's public or LAN IP)
# --admin-host    127.0.0.1 = admin panel only via SSH tunnel; 0.0.0.0 = reachable from anywhere
TUNARIA_ARGS=--host 0.0.0.0 --public-host 203.0.113.10 --admin-host 127.0.0.1

# Optional: fixed admin password instead of a generated one (no forced change at first sign-in).
#EQOA_ADMIN_PASSWORD=change-me
